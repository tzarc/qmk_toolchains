#!/usr/bin/env bash
# Copyright 2024-2025 Nick Brassel (@tzarc)
# SPDX-License-Identifier: GPL-2.0-or-later

set -eEuo pipefail

# macOS SDK Version
export SDK_VERSION=15.0
# macOS Target Version (Monterey)
export MACOSX_DEPLOYMENT_TARGET=12.0

function rcmd() {
    echo -e "\e[0;36mRunning: \e[1;36m$*\e[0m" >&2
    "$@"
}

# If necessary, re-exec with a clean environment inside docker
function respawn_docker_if_needed() {
    if [[ "$(uname -s)" == "Linux" ]] && [[ -n "${EXECUTE_UNDER_DOCKER:-}" ]]; then
        eval "$(parse_args "$@")"
        [ -n "${container_image:-}" ] || container_image='ghcr.io/tzarc/qmk_toolchains:builder'
        [ -n "${interactive:-}" ] && interactive='-it' || interactive=''

        # Because I keep forgetting to run with --interactive when running menuconfig:
        if [[ "${positional_args[0]:-}" == "menuconfig" ]]; then
            interactive='-it'
        fi

        cd "$script_dir"
        rcmd docker run --rm \
            ${interactive:-} \
            -v "$script_dir:$TC_WORKDIR" \
            -w "$TC_WORKDIR" \
            -e TC_WORKDIR="$TC_WORKDIR" \
            --cpus="$(bc -l <<< "scale=2; $(nproc)*0.9")" \
            --memory="$(bc -l <<< "scale=2; $(free -m | awk '/^Mem:/{print $2}') * 0.9 / 1")m" \
            --memory-swap="-1" \
            $container_image \
            ./$(basename $this_script) "$@"
        exit $?
    fi
}

export PATH="$HOME/.local/crosstool-ng/bin:$PATH"

function havecmd() {
    type "${1}" >/dev/null 2>&1 || return 1
}

havecmd gsed && SED=gsed || SED=sed

function cpu_count() {
    nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1
}

function verify_crosstool() {
    if ! havecmd ct-ng; then
        echo "ct-ng not found in PATH. Please install crosstool-ng first." >&2
        exit 1
    fi
}

function fn_os() {
    local os_name=$(echo ${1:-} | tr 'A-Z' 'a-z')
    if [[ -z "$os_name" ]]; then
        os_name=$(uname -s | tr 'A-Z' 'a-z')
    fi
    case "$os_name" in
    *darwin* | *macos* | *apple*)
        echo macos
        ;;
    *windows* | *mingw* | *w64*)
        echo windows
        ;;
    *linux*)
        echo linux
        ;;
    *none* | *unknown* | *picolibc* | *nano*)
        echo baremetal
        ;;
    *)
        echo unknown
        ;;
    esac
}

function fn_arch() {
    local arch_name=$(echo ${1:-} | tr 'A-Z' 'a-z')
    if [[ -z "$arch_name" ]]; then
        arch_name=$(uname -m | tr 'A-Z' 'a-z')
    fi
    case "$arch_name" in
    *arm64* | *aarch64*)
        echo ARM64
        ;;
    *arm*)
        echo ARM
        ;;
    *riscv32*)
        echo RV32
        ;;
    *riscv64*)
        echo RV64
        ;;
    *avr*)
        echo AVR
        ;;
    *x86_64* | *x64*)
        echo X64
        ;;
    *)
        echo unknown
        ;;
    esac
}

function fn_os_arch() {
    echo $(fn_os ${1:-})$(fn_arch ${2:-})
}

function fn_os_arch_fromtriplet() {
    local input_var=${1:-}

    # AVR is a special snowflake.
    if [[ "$input_var" == "avr" ]]; then
        fn_os_arch_fromtriplet avr-none-none
        return
    fi

    # Remove the qmk vendor from the bootstrapped compiler
    input_var=$(echo $input_var | sed -e 's@qmk-@@g')

    local input_arch=$(echo $input_var | cut -d'-' -f1)
    local input_os=$(echo $input_var | cut -d'-' -f2)

    # Try to skip vendor
    if [[ "$input_os" == "unknown" ]] || [[ "$input_os" == "multilib" ]] || [[ "$input_os" == "none" ]] || [[ "$input_os" == "pc" ]] || [[ "$input_os" == "rpi3" ]] || [[ "$input_os" == "w64" ]]; then
        input_os=$(echo $input_var | cut -d'-' -f3)
    fi

    # If we're into the ABI stuff, then backtrack
    if [[ "$input_os" == "eabi" ]] || [[ "$input_os" == "elf" ]] || [[ "$input_os" == "mingw32" ]]; then
        input_os=$(echo $input_var | cut -d'-' -f2)
    fi

    fn_os_arch $input_os $input_arch
}

function build_one_args() {
    cat <<__EOT__
--help                  -- Shows this help text
--build-target=<target> -- Which ct-ng build target to execute, default is 'build' (optional)
--sample-name=<sample>  -- Seeds the crosstool-ng build with the sample configuration (required)
--vendor-name=<vendor>  -- Overrides the vendor previously supplied by the sample (optional)
--build-host-compile    -- Builds the toolchains targeting an older version of gcc for later version compatibility (optional)
--canadian-host=<host>  -- The intended final host machine that the toolchain will be executed (optional)
--no-cross-gdb-python   -- Disabled python when building cross-gdb for canadian builds (optional)
--libc=<flavour>        -- Overrides the C library to build. Usually 'picolibc', 'newlib', or 'none'. (optional)
--extra-newlib-nano     -- Builds newlib-nano in addition to the usual C library (optional)
--extra-picolibc        -- Builds picolibc in addition to the usual C library (optional)
--multilib-list=<value> -- Overrides the list of multilib targets generated. Sets \$CT_CC_GCC_MULTILIB_LIST. (optional)
--tools-prefix=<value>  -- Override the build toolchain. For example \`x86_64-unknown-linux-gnu-\`, with the trailing slash. \`gcc\` et.al. will be appended. (optional)
--dir-suffix=<value>    -- Appends a suffix to the toolchain output directory. (optional)
--container-image       -- Which container image to use.
--no-keep-state         -- Don't save the state of the build. (optional)
--interactive           -- Adds \`-it\` to the \`docker\` invocation. (optional)
__EOT__
}

function build_one_help() {
    for arg in "$@"; do
        case "$arg" in
        --help)
            echo
            echo "$(basename $this_script) $(build_one_args | grep '(required)' | ${SED} -e 's@\s\+--.*@@g') $(build_one_args | sort | grep '(optional)' | ${SED} -e 's@\s\+--.*@@g' -e 's@^@[@' -e 's@$@]@' | tr '\n' ' ')"
            echo
            build_one_args
            exit 0
            ;;
        esac
    done
}

function ct_ng_olddefconfig() {
    ct-ng olddefconfig 2>&1 |
        grep -vE 'CONF.*olddefconfig' |
        grep -vE '^#' |
        grep -vE 'warning: override:' ||
        true
}

# Surgically replaces an existing config entry in place, or appends it if not already present.
function set_value() {
    local name="$1"
    local value="$2"
    if grep -qE "^(# )?${name}(=.*| is not set)\$" .config; then
        ${SED} -i -e "s@^\(# \)\?\(${name}\)\(=.*\| is not set\)\$@\2=${value}@" .config
    else
        echo "${name}=${value}" >>.config
    fi
}

# Like set_value, but if the entry doesn't exist yet, inserts it next to its choice siblings
# (matched by family_regex) instead of at EOF -- a bare `choice` member appended in isolation at
# the end of the file may get silently reverted by the next `ct-ng olddefconfig`.
function set_choice_value() {
    local family_regex="$1"
    local name="$2"
    local value="$3"
    # A choice group permits only one selection, so clear any other enabled sibling first.
    ${SED} -i -e "s@^\(${family_regex}\)=.*\$@# \1 is not set@" .config
    if grep -qE "^(# )?${name}(=.*| is not set)\$" .config; then
        ${SED} -i -e "s@^\(# \)\?\(${name}\)\(=.*\| is not set\)\$@\2=${value}@" .config
    else
        local last_line=$(grep -nE "^(# )?${family_regex}(=.*| is not set)\$" .config | tail -1 | cut -d: -f1)
        if [[ -n "${last_line}" ]]; then
            ${SED} -i "${last_line}a ${name}=${value}" .config
        else
            echo "${name}=${value}" >>.config
        fi
    fi
}

function parse_args() {
    set -eEuo pipefail
    umask 022

    while read arg; do
        unset $arg
    done < <(build_one_args | ${SED} -e 's@\s\+--.*@@g' -e 's@^--@@g' -e 's@-@_@g' -e 's@=.*@@g')
    unset arg

    local -a positional_args=()
    while [[ ! -z "${1:-}" ]]; do
        echo -e "\e[0;33m - Arg: \e[1;33m$1\e[0m" >&2
        case "$1" in
        --*=*)
            N=${1%%=*}
            N=${N##--}
            N=$(echo $N | tr '-' '_')
            V=${1##*=}
            echo export $N="$V"
            ;;
        --*)
            N=${1##--}
            N=$(echo $N | tr '-' '_')
            echo export $N=true
            ;;
        *)
            positional_args+=($1)
            ;;
        esac
        shift
        unset N
        unset V
    done
    echo "positional_args=("${positional_args[@]}")"
}

function build_one() {
    set -eEuo pipefail
    umask 022
    verify_crosstool
    eval "$(parse_args "$@")"

    if [[ ! -z "${help:-}" ]]; then
        build_one_args
        exit 0
    fi

    [[ -d "$script_dir/tarballs" ]] || mkdir -p $script_dir/tarballs

    if [[ ! -z "${canadian_host:-}" ]]; then
        name_host=$(fn_os_arch_fromtriplet $canadian_host)
        name_target=$(fn_os_arch_fromtriplet $sample_name)
    else
        name_host=$(fn_os_arch)
        name_target=$(fn_os_arch_fromtriplet $sample_name)
    fi
    target_dir="host_${name_host}-target_${name_target}${dir_suffix:-}"

    echo ============
    echo ' BUILD TARGET:' $target_dir
    echo '    BUILD DIR:' "$script_dir/build/$target_dir"
    echo 'TOOLCHAIN DIR:' "$script_dir/toolchains/$target_dir"
    echo ============
    echo

    local build_dir="$script_dir/build/$target_dir"
    local toolchain_dir="$script_dir/toolchains/$target_dir"

    mkdir -p "$build_dir"
    cd "$build_dir"

    # Remove any existing configuration
    [[ ! -e .config ]] || rm .config

    # Load the crosstool-ng sample configuration for the target
    ct-ng $sample_name

    # Set up the build environment params
    set_value CT_EXPERIMENTAL y # required for some features
    set_value CT_FORCE_EXTRACT y

    # Enable stripping of the toolchain executables
    set_value CT_STRIP_HOST_TOOLCHAIN_EXECUTABLES y
    set_value CT_STRIP_TARGET_TOOLCHAIN_EXECUTABLES y

    # Don't go overboard with the parallel jobs
    set_value CT_PARALLEL_JOBS "$(cpu_count)"

    ct_ng_olddefconfig
    
    # Disable the progress bar and other unnecessary features, and zstd support was broken last time it was checked
    set_value CT_LOCAL_TARBALLS_DIR "\"$script_dir/tarballs\""
    set_value CT_LOG_PROGRESS_BAR n
    set_value CT_PREFIX_DIR_RO n
    set_value CT_CC_LANG_CXX y
    set_value CT_CC_GCC_LTO_ZSTD n
    set_value CT_COMP_LIBS_ZSTD n
    set_value CT_ZSTD_NEEDED n
    set_value CT_ZSTD n
    set_value CT_DEBUG_GDB y

    # gdb v17 seems to be broken on macOS ARM64, so pin to v16 for now.
    set_choice_value 'CT_GDB_V_[A-Za-z0-9_]*' CT_GDB_V_16 y
    ct_ng_olddefconfig

    # GDB's TUI causes issues with the build, so disable it.
    set_value CT_GDB_CROSS_EXTRA_CONFIG_ARRAY '"--disable-tui"' # see https://github.com/crosstool-ng/crosstool-ng/issues/321

    # For baremetal ARM toolchains, pin binutils at 2.43 due to issues with ARM relocations (ChibiOS-Contrib): https://gcc.gnu.org/pipermail/gcc-help/2025-May/144169.html
    # Fixed in https://github.com/ChibiOS/ChibiOS-Contrib/commit/2fb815dfe05607e65f85083393e1c3aa41cdea3d (2025-06-06)
    # Can remove this override once newer ChibiOS-Contrib submodule revisions are merged into QMK firmware.
    if [[ -z "${build_host_compile:-}" ]] && [[ "${sample_name:-}" == *"arm"* ]]; then
        set_choice_value 'CT_BINUTILS_V_[A-Za-z0-9_]*' CT_BINUTILS_V_2_43 y
    fi

    if [[ ! -z "$(echo $sample_name | grep linux)" ]]; then
        # Swap to an older version of glibc to avoid issues with older distros, especially things like older Debian with Raspberry Pi targets.
        # See the glibc version compat list here: https://abi-laboratory.pro/?view=timeline&l=glibc -- 2.28 seems safe enough?
        # NOTE: this must happen before any GCC version override below -- newer glibc versions select
        # GCC_REQUIRE_*_or_later, which makes older CT_GCC_V_* choices invisible and silently reverted
        # by ct-ng olddefconfig.
        if [[ ! -z "$(echo $sample_name | grep riscv64-unknown-linux-gnu)" ]]; then
            set_choice_value 'CT_GLIBC_V_[A-Za-z0-9_]*' CT_GLIBC_V_2_36 y
            set_value CT_GLIBC_OLDEST_ABI '"2.36"'
            set_value CT_CC_GCC_EXTRA_CONFIG_ARRAY '"--with-glibc-version=2.36"'
        else
            set_choice_value 'CT_GLIBC_V_[A-Za-z0-9_]*' CT_GLIBC_V_2_28 y
            set_value CT_GLIBC_OLDEST_ABI '"2.28"'
            set_value CT_CC_GCC_EXTRA_CONFIG_ARRAY '"--with-glibc-version=2.28"'
        fi
        ct_ng_olddefconfig
    fi

    # Builder older versions of the toolchain when we're building the base cross-compilers
    if [[ ! -z "${build_host_compile:-}" ]]; then
        # Don't need gdb for the host builds
        set_value CT_DEBUG_GDB n

        ${SED} -i \
            -e 's/^\(# \)\?\(CT_GCC_[0-9][A-Za-z0-9_]*_or_older\)\(=.*\| is not set\)$/# \2 is not set/' \
            -e 's/^\(# \)\?\(CT_GCC_[0-9][A-Za-z0-9_]*_or_later\)\(=.*\| is not set\)$/# \2 is not set/' \
            -e 's/^\(# \)\?\(CT_GCC_REQUIRE_[0-9][A-Za-z0-9_]*_or_later\)\(=.*\| is not set\)$/# \2 is not set/' \
            -e 's/^\(# \)\?\(CT_GCC_later_than_[A-Za-z0-9_]*\)\(=.*\| is not set\)$/# \2 is not set/' \
            -e 's/^\(# \)\?\(CT_GCC_older_than_[A-Za-z0-9_]*\)\(=.*\| is not set\)$/# \2 is not set/' \
            .config

        if [[ ! -z "$(echo $sample_name | grep riscv64-unknown-linux-gnu)" ]]; then
            set_choice_value 'CT_GCC_V_[A-Za-z0-9_]*' CT_GCC_V_10 y
            set_value CT_GCC_VERSION '"10.5.0"'
        else
            set_choice_value 'CT_GCC_V_[A-Za-z0-9_]*' CT_GCC_V_8 y
            set_value CT_GCC_VERSION '"8.5.0"'
        fi

        ct_ng_olddefconfig

        set_choice_value 'CT_MINGW_W64_V_[A-Za-z0-9_]*' CT_MINGW_W64_V_V10_0 y
        set_value CT_MINGW_W64_VERSION '"v10.0.0"'

        ct_ng_olddefconfig
    fi

    ct_ng_olddefconfig

    # Swap to an older version of Linux (LTS) and glibc to avoid execution issues with older distros, especially things like older Debian with Raspberry Pi targets.
    if [[ ! -z "$(echo $sample_name | grep riscv64-unknown-linux-gnu)" ]]; then
        # rv64 needs a slightly newer kernel
        set_choice_value 'CT_LINUX_V_[A-Za-z0-9_]*' CT_LINUX_V_5_10 y
        set_value CT_LINUX_VERSION '"5.10"'
        set_value CT_GLIBC_MIN_KERNEL '"5.10"'
        set_choice_value 'CT_GLIBC_KERNEL_VERSION_[A-Za-z0-9_]*' CT_GLIBC_KERNEL_VERSION_AS_HEADERS y
    else
        set_choice_value 'CT_LINUX_V_[A-Za-z0-9_]*' CT_LINUX_V_4_19 y
        set_value CT_LINUX_VERSION '"4.19"'
        set_value CT_GLIBC_MIN_KERNEL '"4.19"'
        set_choice_value 'CT_GLIBC_KERNEL_VERSION_[A-Za-z0-9_]*' CT_GLIBC_KERNEL_VERSION_AS_HEADERS y
    fi

    ct_ng_olddefconfig

    # Disable unnecessary languages
    set_value CT_CC_LANG_FORTRAN n
    set_value CT_CC_LANG_JIT n
    set_value CT_CC_LANG_ADA n
    set_value CT_CC_LANG_D n
    set_value CT_CC_LANG_OBJC n
    set_value CT_CC_LANG_OBJCXX n
    set_value CT_CC_LANG_GOLANG n

    # Too many concurrent LTO runs breaks RISC-V builds on GHA, which terminate due to being OOM
    # See https://bugs.gentoo.org/946338 for similar issues
    # The following set of options all reduce memory usage during linking of the compiler itself. RISC-V builds will randomly fail on GitHub Actions runs if these aren't present.
    # NOTE: appends to (rather than replaces) any existing CT_CC_GCC_EXTRA_CONFIG_ARRAY (e.g. --with-glibc-version set above) -- it's a plain Kconfig string, so a second set_value would otherwise clobber it.
    existing_gcc_extra_config_array=$(${SED} -n -e 's@^CT_CC_GCC_EXTRA_CONFIG_ARRAY="\(.*\)"$@\1@p' .config)
    set_value CT_CC_GCC_EXTRA_CONFIG_ARRAY "\"${existing_gcc_extra_config_array:+$existing_gcc_extra_config_array }--enable-link-serialization=1 --with-build-config=bootstrap-O1\""
    set_value CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY '"--enable-link-serialization=1 --with-build-config=bootstrap-O1"'
    set_value CT_CC_GCC_DISABLE_PCH y
    set_value CT_EXTRA_CFLAGS_FOR_HOST '"-Os -g0"'
    set_value CT_EXTRA_CXXFLAGS_FOR_HOST '"-Os -g0"'
    if [ -n "${canadian_host:-}" ] && [ -z "$(echo $toolchain_dir | grep macos)" ]; then
        # These only seem to be available with the toolchains built by the base container -- the macOS cross-compilers don't have them.
        # Those don't seem to have an issue with LTO, so safe to skip here.
        set_value CT_EXTRA_LDFLAGS_FOR_HOST '"-Wl,--no-keep-memory -Wl,--reduce-memory-overheads"'
    fi

    ct_ng_olddefconfig

    # Configure the required C library
    if [[ ! -z "${libc:-}" ]]; then
        set_value "CT_LIBC_$(echo $libc | tr 'a-z' 'A-Z')" y
        set_value CT_LIBC "\"$(echo $libc | tr 'A-Z' 'a-z')\""
        set_value CT_COMP_LIBS_NEWLIB_NANO n
        set_value CT_COMP_LIBS_PICOLIBC n
        ct_ng_olddefconfig

        if [[ "${libc}" == "newlib" ]]; then
            set_value CT_LIBC_NEWLIB_DISABLE_SUPPLIED_SYSCALLS n
        fi
        ct_ng_olddefconfig
    fi

    # Enable newlib-nano if requested
    if [[ ! -z "${extra_newlib_nano:-}" ]]; then
        set_value CT_COMP_LIBS_NEWLIB_NANO y
        ct_ng_olddefconfig
        set_value CT_LIBC_NEWLIB_EXTRA_SECTIONS y
        set_value CT_LIBC_NEWLIB_NANO_MALLOC y
        set_value CT_NEWLIB_NANO_INSTALL_IN_TARGET y
        set_value CT_LIBC_NEWLIB_NANO_EXTRA_SECTIONS y
        ct_ng_olddefconfig
    fi

    # Enable picolibc if requested
    if [[ ! -z "${extra_picolibc:-}" ]]; then
        set_value CT_COMP_LIBS_PICOLIBC y
        ct_ng_olddefconfig
        set_value CT_PICOLIBC_INSTALL_IN_TARGET y
        set_value CT_LIBC_PICOLIBC_GCC_LIBSTDCXX y
        ct_ng_olddefconfig
    fi

    # Set the list of multilib targets
    if [[ ! -z "${multilib_list:-}" ]]; then
        set_value CT_CC_GCC_MULTILIB_LIST "\"$multilib_list\""
        ct_ng_olddefconfig
    fi

    # Override the vendor name string
    if [[ ! -z "${vendor_name:-}" ]]; then
        set_value CT_TARGET_VENDOR "\"$vendor_name\""
        ct_ng_olddefconfig
    fi

    # Disable python for cross-compile GDB if necessary
    if [[ ! -z "${no_cross_gdb_python:-}" ]]; then
        set_value CT_GDB_CROSS_PYTHON n
        ct_ng_olddefconfig
    fi

    # Enable canadian builds if requested
    if [[ ! -z "${canadian_host:-}" ]]; then
        set_value CT_CROSS n
        set_value CT_CANADIAN y
        set_value CT_TOOLCHAIN_TYPE '"canadian"'

        set_value CT_HOST "\"${canadian_host}\""

        if [[ ! -z "$(echo ${canadian_host} | grep mingw32)" ]]; then
            # Fixup Windows builds:
            set_value CT_LIBC_GLIBC n
            set_value CT_BINUTILS_PLUGINS n # need to disable these as builds providing LTO fail on Windows because the DLLs export too many symbols (>65536)
        fi

        ct_ng_olddefconfig
    fi

    # Set the toolchain output directory
    set_value CT_PREFIX_DIR "\"$toolchain_dir\""
    ct_ng_olddefconfig

    # Enable debug options
    set_value CT_DEBUG_CT y
    ct_ng_olddefconfig

    if [[ -z "${no_keep_state:-}" ]]; then
        # Save the build steps so that we can save/restore on GHA due to build execution time limits.
        set_value CT_DEBUG_CT_SAVE_STEPS y
        set_value CT_DEBUG_CT_SAVE_STEPS_GZIP y
        set_value CT_DEBUG_CT_SAVE_STEPS_LAST_ONLY y
    fi

    # Set the toolchain version string
    # NOTE: can't use set_value here -- the value contains both '/' (path) and '@' (separator), the only two delimiters set_value/set_choice_value support.
    echo "CT_TOOLCHAIN_PKGVERSION=\"qmk/qmk_toolchains @ $(git describe --always --dirty --exclude '*')\"" >>.config

    if [[ -n "${tools_prefix:-}" ]]; then
        # Set the tools prefix
        set_value CT_BUILD_PREFIX "\"${tools_prefix}\""
    fi

    ct_ng_olddefconfig

    # Save a copy of the "cut-down" config for inspection purposes.
    ct-ng savedefconfig
    echo ================================================================================================
    echo == begin defconfig =============================================================================
    echo ================================================================================================
    cat defconfig
    echo ================================================================================================
    echo == end defconfig ===============================================================================
    echo ================================================================================================
    echo

    # Add the other compilers to the PATH for use in canadian builds
    while read bindir; do
        export PATH="$bindir:$PATH"
    done < <(find "$script_dir/toolchains/host_$(fn_os_arch)"* -maxdepth 1 -type d -name bin || true)
    unset bindir

    # Dump out the resulting path
    echo '$PATH:'
    echo "$PATH" | tr ':' '\n'

    if [[ ${#positional_args[@]} -eq 0 ]]; then
        positional_args+=(build)
    fi

    if [[ ${#positional_args[@]} -eq 1 ]] && [[ "${positional_args[0]}" == "source" ]]; then
        ct-ng source || true
    else
        nice -n 10 ionice -c 3 ct-ng ${positional_args[@]}

        if [ -n "${canadian_host:-}" ] && [ -n "$(echo $toolchain_dir | grep macos)" ]; then
            # Patch the `@rpath` of the toolchain binaries so that they look in `@executable_path/../lib` for libraries
            find "$toolchain_dir/bin" -type f -executable -exec "${canadian_host}-install_name_tool" -add_rpath "@executable_path/../lib" '{}' \; || true
            # Copy across libstdc++ for gdb
            cp /gcc/${canadian_host}/lib/libstdc++.6.dylib "$toolchain_dir/lib" || true
            # Codesign macOS executables
            find "$toolchain_dir" -type f -executable -print -exec rcodesign sign '{}' \; || true
        fi

        # Save identifying information
        [ -d "$toolchain_dir/etc" ] || mkdir -p "$toolchain_dir/etc"
        echo "TOOLCHAIN_HOST=${name_host}" >"$toolchain_dir/etc/toolchain_release_${name_host}_${name_target}"
        echo "TOOLCHAIN_TARGET=${name_target}" >>"$toolchain_dir/etc/toolchain_release_${name_host}_${name_target}"
        echo "COMMIT_DATE=$(date -u -d "$(git show --no-patch --format=%cI HEAD)" +%Y-%m-%dT%H:%M:%SZ)" >>"$toolchain_dir/etc/toolchain_release_${name_host}_${name_target}"
        echo "COMMIT_HASH=$(git describe --always --dirty --exclude '*')" >>"$toolchain_dir/etc/toolchain_release_${name_host}_${name_target}"
    fi
}
